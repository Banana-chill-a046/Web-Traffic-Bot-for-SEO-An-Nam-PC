{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/massive.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.html"
    },
    {
      "src": "/api",
      "dest": "/api/index.html"
    },
    {
      "src": "/api/index.js",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/massive.js",
      "dest": "/api/massive.js"
    }
  ]
}
